# ─── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=46.101.126.39,localhost,127.0.0.1

# ─── Database ────────────────────────────────────────────────────────────────
# Production: postgresql. Local smoke test: sqlite
DB_ENGINE=postgresql
DB_NAME=prava_exam
DB_USER=prava_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=pravagosuperbot

# ─── Payment Botlari (alohida 2 ta bot) ──────────────────────────────────────
# User to'lov yuboradigan bot
PAYMENT_USER_BOT_TOKEN=user_payment_bot_token
PAYMENT_USER_BOT_USERNAME=pravaXAdminBot
# Adminlar tasdiqlaydigan bot
PAYMENT_ADMIN_BOT_TOKEN=admin_payment_bot_token
PAYMENT_ADMIN_BOT_USERNAME=PravaXPayBot

# ─── Email — Resend.com (tavsiya etiladi, SMTP bloklanmaydi) ─────────────────
# resend.com da ro'yxatdan o'ting → API Keys → API key oling
RESEND_API_KEY=re_xxxxxxxxxx
DEFAULT_FROM_EMAIL=Prava GO <noreply@yourdomain.com>

# ─── Email — SMTP (ixtiyoriy, RESEND_API_KEY bo'lmasa ishlatiladi) ────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
